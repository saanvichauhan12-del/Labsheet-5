#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter numbers (-1 to stop):\n";
    while (true) {
        cin >> n;
        if (n == -1)
            break;  // end input
        if (n < 0)
            continue;  // skip negative numbers
        cout << "You entered: " << n << endl;
    }

    return 0;
}
