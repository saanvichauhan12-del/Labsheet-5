#include <iostream>
using namespace std;

int main() {
    int arr[] = {3, 7, 2, 9, 5};
    int n = 5, num;
    cout << "Enter number to search: ";
    cin >> num;

    for(int i = 0; i < n; i++) {
        if(arr[i] == num) {
            cout << "Number found at position " << i + 1;
            break;
        }
        if(i == n - 1)
            cout << "Number not found.";
    }
    return 0;
}
