#include <iostream>
using namespace std;

int main() {
    cout << "Harshad numbers between 1 and 100 are:\n";

    for (int i = 1; i <= 100; i++) {
        int n = i, sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }
        if (i % sum == 0)
            cout << i << " ";
    }

    return 0;
}
