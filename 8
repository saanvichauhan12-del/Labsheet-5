#include <iostream>
using namespace std;

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    for (int i = 1; i <= 10; i++) {
        int product = num * i;
        if (product > 50)
            break;  // stop when product exceeds 50
        cout << num << " x " << i << " = " << product << endl;
    }

    return 0;
}
