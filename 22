#include <iostream>
using namespace std;

int main() {
    cout << "Palindrome numbers between 1 and 500 are:\n";

    for (int i = 1; i <= 500; i++) {
        int n = i, rev = 0, rem;
        while (n > 0) {
            rem = n % 10;
            rev = rev * 10 + rem;
            n /= 10;
        }
        if (rev == i)
            cout << i << " ";
    }

    return 0;
}
