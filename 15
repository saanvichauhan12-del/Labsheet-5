#include <iostream>
#include <cmath>
using namespace std;

int main() {
    cout << "Armstrong numbers between 1 and 500 are:\n";

    for (int i = 1; i <= 500; i++) {
        int num = i, rem, sum = 0;

        while (num > 0) {
            rem = num % 10;
            sum += pow(rem, 3);
            num /= 10;
        }

        if (sum == i)
            cout << i << " ";
    }

    return 0;
}
